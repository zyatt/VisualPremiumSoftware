generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                       Int                   @id @default(autoincrement())
  nome                     String
  username                 String                @unique
  senha                    String
  role                     Role                  @default(COMPRAS)
  ativo                    Boolean               @default(true)
  criadoEm                 DateTime              @default(now())
  atualizadoEm             DateTime              @updatedAt
  orcamentosAprovados      Orcamento[]           @relation("AprovadorOrcamento")
  orcamentosCriados        Orcamento[]           @relation("OrcamentoCriador")
  ordens_compra            OrdemCompra[]
  solicitacoesProducao     SolicitacaoProducao[]
  orcamentosVendaCriados   OrcamentoVenda[]      @relation("OrcamentoVendaCriador")
  solicitacoesMaterial     SolicitacaoMaterial[] @relation("SolicitacoesMaterial")
  logsEdicaoSolicitacao    LogEdicaoSolicitacao[] @relation("LogEdicaoEditor")
  mensagensEnviadas        MensagemChat[] @relation("MensagemRemetente")
  mensagensRecebidas       MensagemChat[] @relation("MensagemDestinatario")
  visualizacoesSolicitacao VisualizacaoSolicitacao[]
  ultimoAcesso             DateTime?
  @@map("usuarios")
}

model MensagemChat {
  id             Int      @id @default(autoincrement())
  remetenteId    Int
  destinatarioId Int
  conteudo       String   @db.Text
  lida           Boolean  @default(false)
  criadoEm       DateTime @default(now())
  reacoes        Json     @default("{}")
  editadaEm      DateTime?
  apagada        Boolean  @default(false)
  respondendoAId Int?
  respondendoA   MensagemChat?  @relation("RespostaMensagem", fields: [respondendoAId], references: [id], onDelete: SetNull)
  respostas      MensagemChat[] @relation("RespostaMensagem")
  remetente      Usuario  @relation("MensagemRemetente",    fields: [remetenteId],    references: [id], onDelete: Cascade)
  destinatario   Usuario  @relation("MensagemDestinatario", fields: [destinatarioId], references: [id], onDelete: Cascade)

  @@index([remetenteId, destinatarioId])
  @@index([destinatarioId, lida])
  @@map("mensagens_chat")
}

model Material {
  id                          Int                        @id @default(autoincrement())
  nome                        String
  unidade                     String?
  categoria                   String?
  medida                      String?
  espessura                   String?
  largura                     Decimal?                   @db.Decimal(10, 4)
  comprimento                 Decimal?                   @db.Decimal(10, 4)
  identificador               String?
  valor                       Decimal?                   @db.Decimal(15, 6)
  valorMetroQuadrado          Decimal?                   @db.Decimal(15, 6)
  quantidade                  Decimal                    @default(0) @db.Decimal(15, 6)
  estoqueMinimo               Decimal                    @default(0) @db.Decimal(15, 6)
  status                      StatusEstoque              @default(OK)
  estoqueConfirmado           Boolean                    @default(false)
  ativo                       Boolean                    @default(true)
  ultimoValorPago             Decimal?                   @db.Decimal(15, 6)
  ultimoValorPagoM2           Decimal?                   @db.Decimal(15, 6)
  criadoEm                    DateTime                   @default(now())
  atualizadoEm                DateTime                   @updatedAt
  fornecedorMateriais         FornecedorMaterial[]
  historicoPrecos             HistoricoPrecoMaterial[]
  movimentacoes               MovimentacaoEstoque[]      @relation("MovimentacaoMaterial")
  movimentacoesOrigem         MovimentacaoEstoque[]      @relation("MovimentacaoMaterialOrigem")
  orcamentoItens              OrcamentoItem[]
  ordemItens                  OrdemCompraItem[]
  SolicitacoesProducao        SolicitacaoProducao[]
  auditLogs                   AuditLogMaterial[]
  produtoMateriais            ProdutoMaterial[]
  orcamentoVendaItemMateriais OrcamentoVendaItemMaterial[]
  itensSolicitacao            ItemSolicitacaoMaterial[]
  adicionaisSolicitacao       AdicionalSolicitacaoMaterial[]
  estoqueProducao             EstoqueProducao[]
  movimentacoesProducao       MovimentacaoProducao[]
  entradasPendentes           EntradaPendente[]

  // A unicidade lógica (nome + identificador + medida + espessura) NÃO é mais
  // garantida pelo @@unique padrão abaixo, porque o Postgres trata NULL como
  // sempre diferente de NULL — então dois materiais com identificador/medida/
  // espessura em branco não eram bloqueados por essa constraint, permitindo
  // duplicatas quando o formulário era enviado duas vezes rapidamente.
  //
  // A proteção real agora vem de um ÍNDICE ÚNICO DE EXPRESSÃO, criado na
  // migração `migration.sql`, que trata NULL como '' (string vazia) só para
  // fins de comparação de unicidade — sem alterar o tipo das colunas nem o
  // comportamento do resto da aplicação. Ver:
  //   materiais_nome_identificador_medida_espessura_null_safe_key
  //
  // Este @@unique é mantido comentado apenas como referência histórica —
  // NÃO reative sem entender a limitação acima.
  // @@unique([nome, identificador, medida, espessura])
  @@map("materiais")
}

model HistoricoPrecoMaterial {
  id            Int         @id @default(autoincrement())
  materialId    Int
  ordemCompraId Int
  fornecedorId  Int
  precoUnitario Decimal?    @db.Decimal(15, 6)
  precoM2       Decimal?    @db.Decimal(15, 6)
  quantidade    Decimal     @db.Decimal(15, 6)
  qtdUnidade    Decimal?    @db.Decimal(15, 6)
  usarM2        Boolean     @default(false)
  criadoEm      DateTime    @default(now())
  fornecedor    Fornecedor  @relation(fields: [fornecedorId], references: [id])
  material      Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  ordemCompra   OrdemCompra @relation(fields: [ordemCompraId], references: [id], onDelete: Cascade)

  @@map("historico_precos_material")
}

model Fornecedor {
  id              Int                      @id @default(autoincrement())
  nomeFantasia    String
  tipoFornecedor  String?
  telefone        String?
  cnpj            String?                  @unique
  razaoSocial     String?
  nomeVendedor    String?
  imagemUrl       String?
  ativo           Boolean                  @default(true)
  criadoEm        DateTime                 @default(now())
  atualizadoEm    DateTime                 @updatedAt
  materiais       FornecedorMaterial[]
  historicoPrecos HistoricoPrecoMaterial[]
  orcamentoItens  OrcamentoItem[]
  ordens_compra   OrdemCompra[]

  @@map("fornecedores")
}

model FornecedorMaterial {
  id                 Int        @id @default(autoincrement())
  fornecedorId       Int
  materialId         Int
  preco              Decimal?   @db.Decimal(15, 6)
  precoMetroQuadrado Decimal?   @db.Decimal(15, 6)
  precoUnidadeMedida Decimal?   @db.Decimal(15, 6)
  ativo              Boolean    @default(true)
  criadoEm           DateTime   @default(now())
  atualizadoEm       DateTime   @updatedAt
  fornecedor         Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  material           Material   @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([fornecedorId, materialId])
  @@map("fornecedor_materiais")
}

model Orcamento {
  id                  Int             @id @default(autoincrement())
  titulo              String          @default("Orçamento")
  status              StatusOrcamento @default(ABERTO)
  criadorId           Int?
  aprovadorId         Int?
  aprovadoEm          DateTime?
  motivoRejeicao      String?
  criadoEm            DateTime        @default(now())
  atualizadoEm        DateTime        @updatedAt
  fornecedoresOcultos Int[]           @default([])
  /// Modo de precificação usado no comparativo de preços e ao gerar a OC:
  /// 'UNIDADE' (preço do fornecedor é por unidade/peça) ou 'METRO_LINEAR'
  /// (preço já é por m/l — multiplica também pela Quantidade por Unidade de
  /// cada item). Definido pelo botão "Orçar por" no editor.
  modoPrecificacao    String          @default("UNIDADE")
  itens               OrcamentoItem[]
  aprovador           Usuario?        @relation("AprovadorOrcamento", fields: [aprovadorId], references: [id])
  criador             Usuario?        @relation("OrcamentoCriador", fields: [criadorId], references: [id])
  ordens              OrdemCompra[]

  @@map("orcamentos")
}

model OrcamentoItem {
  id            Int         @id @default(autoincrement())
  orcamentoId   Int
  materialId    Int
  fornecedorId  Int?
  quantidade    Decimal     @default(1) @db.Decimal(15, 6)
  qtdUnidade    Decimal?    @db.Decimal(15, 6)
  precoUnitario Decimal?    @db.Decimal(15, 6)
  precoM2       Decimal?    @db.Decimal(15, 6)
  usarM2        Boolean     @default(false)
  selecionado   Boolean     @default(false)
  descricaoItem String?
  observacao    String?
  criadoEm      DateTime    @default(now())
  fornecedor    Fornecedor? @relation(fields: [fornecedorId], references: [id])
  material      Material    @relation(fields: [materialId], references: [id])
  orcamento     Orcamento   @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@unique([orcamentoId, materialId, fornecedorId])
  @@map("orcamento_itens")
}

model OrdemCompra {
  id              Int                      @id @default(autoincrement())
  data            DateTime                 @default(now())
  fornecedorId    Int
  requisitante    String
  formaPagamento  String?
  prazoPagamento  String?
  observacoes     String?
  empresa         String?
  status          StatusOrdemCompra        @default(EM_ANDAMENTO)
  usuarioId       Int?
  orcamentoId     Int?
  valorTotal      Decimal                  @default(0) @db.Decimal(15, 6)
  criadoEm        DateTime                 @default(now())
  atualizadoEm    DateTime                 @updatedAt
  historicoPrecos HistoricoPrecoMaterial[]
  movimentacoes   MovimentacaoEstoque[]
  itens           OrdemCompraItem[]
  numerosOS       OrdemCompraOS[]
  fornecedor      Fornecedor               @relation(fields: [fornecedorId], references: [id])
  orcamento       Orcamento?               @relation(fields: [orcamentoId], references: [id])
  usuario         Usuario?                 @relation(fields: [usuarioId], references: [id])

  @@map("ordens_compra")
}

model OrdemCompraOS {
  id            Int         @id @default(autoincrement())
  ordemCompraId Int
  numeroOS      String
  ordemCompra   OrdemCompra @relation(fields: [ordemCompraId], references: [id], onDelete: Cascade)

  @@map("ordem_compra_os")
}

model OrdemCompraItem {
  id                 Int         @id @default(autoincrement())
  ordemCompraId      Int
  materialId         Int?
  descricaoItem      String?
  numeroOS           String
  quantidade         Decimal     @db.Decimal(15, 6)
  qtdUnidade         Decimal?    @db.Decimal(15, 6)
  precoUnitario      Decimal     @db.Decimal(15, 6)
  precoMetroQuadrado Decimal?    @db.Decimal(15, 6)
  usarM2             Boolean     @default(false)
  precoTotal         Decimal     @db.Decimal(15, 6)
  criadoEm           DateTime    @default(now())
  material           Material?   @relation(fields: [materialId], references: [id])
  ordemCompra        OrdemCompra @relation(fields: [ordemCompraId], references: [id], onDelete: Cascade)

  @@map("ordem_compra_itens")
}

model RelacaoOS {
  id            Int                   @id @default(autoincrement())
  numeroOS      String                @unique
  descricao     String?
  /// Nome do cliente vinculado a esta OS (opcional). Preenchido pelo
  /// usuário ao dar entrada/saída na OS, ou renomeado depois através do
  /// mesmo fluxo usado para renomear a OS.
  cliente       String?
  status        String                @default("EM_ANDAMENTO")
  /// Nome do usuário que fechou esta OS (snapshot no momento do fechamento,
  /// não uma FK — evita quebrar o histórico se o usuário for excluído
  /// depois). Fica null enquanto a OS está em andamento, ou se foi revertida
  /// e ainda não fechada de novo.
  fechadoPorNome String?
  criadoEm      DateTime              @default(now())
  atualizadoEm  DateTime              @updatedAt
  movimentacoes MovimentacaoEstoque[]

  @@map("relacoes_os")
}

model MovimentacaoEstoque {
  id               Int          @id @default(autoincrement())
  materialId       Int
  tipo             String
  quantidade       Decimal      @db.Decimal(15, 6)
  numeroOS         String
  relacaoOSId      Int
  ordemCompraId    Int?
  precoUnitario    Decimal?     @db.Decimal(15, 6)
  precoM2          Decimal?     @db.Decimal(15, 6)
  observacao       String?
  descricaoItem    String?
  larguraUsada     Decimal?     @db.Decimal(15, 6)
  comprimentoUsado Decimal?     @db.Decimal(15, 6)
  materialOrigemId Int?
  // Fonte da verdade para distinguir a origem de uma SAIDA relacionada ao
  // fluxo de produção: 'TRANSFERENCIA' (saída via transferirParaProducao,
  // estoque normal -> produção) ou 'BAIXA' (saída de registro gerada por
  // darBaixa, quando o material já havia saído do estoque normal antes).
  // null para qualquer movimentação normal, alheia ao fluxo de produção.
  // Gravado no momento da criação — ver estoqueProducao.service.js.
  // Registros criados antes desta coluna existir ficam com null; nesses
  // casos estoque.service.js cai no fallback por texto/numeroOS.
  origemProducao   String?
  /// '1' ou '2' — preenchido apenas quando [origemProducao] não é nulo,
  /// identifica a qual linha de produção a transferência/baixa pertence.
  /// Registros antigos (pré-migração) ficam com null; nesses casos
  /// estoque.service.js cai no fallback por texto/numeroOS.
  producao         String?
  criadoEm         DateTime     @default(now())
  material         Material     @relation("MovimentacaoMaterial", fields: [materialId], references: [id])
  materialOrigem   Material?    @relation("MovimentacaoMaterialOrigem", fields: [materialOrigemId], references: [id])
  ordemCompra      OrdemCompra? @relation(fields: [ordemCompraId], references: [id])
  relacaoOS        RelacaoOS    @relation(fields: [relacaoOSId], references: [id])

  @@index([materialOrigemId])
  @@map("movimentacoes_estoque")
}

/// Saldo de material transferido do estoque normal para uma linha de
/// produção específica. Existem 2 linhas de produção independentes
/// ('1' e '2') — cada uma com seu próprio saldo por material, visível
/// apenas para usuários com o cargo PRODUCAO correspondente (PRODUCAO1/
/// PRODUCAO2). Não interfere no cálculo de status (OK/LIMITE/CRITICO) do
/// estoque normal — é um saldo à parte, sem estoque mínimo próprio.
model EstoqueProducao {
  id           Int      @id @default(autoincrement())
  materialId   Int
  /// '1' ou '2' — identifica a qual linha de produção este saldo pertence.
  producao     String
  quantidade   Decimal  @default(0) @db.Decimal(15, 6)
  /// Quantidade devolvida ao estoque padrão mas ainda pendente de
  /// confirmação em Controle de Estoque. Fica "no limbo": já saiu de
  /// [quantidade] (disponível na produção) mas ainda não voltou pro
  /// Material do estoque padrão. Ver EntradaPendente (tipo DEVOLUCAO).
  quantidadePendente Decimal @default(0) @db.Decimal(15, 6)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  material     Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, producao])
  @@index([producao])
  @@map("estoque_producao")
}

/// Fila de entradas do fluxo de produção que aguardam confirmação manual em
/// Controle de Estoque antes de impactar o estoque padrão. Cobre dois
/// casos, distinguidos por [tipo]:
/// - RETALHO: sobra gerada por uma baixa de produção (darBaixa). Antes da
///   confirmação, nenhum Material de retalho é criado/incrementado.
/// - DEVOLUCAO: devolução da produção para o estoque padrão. A quantidade
///   já sai de EstoqueProducao.quantidade na hora, mas fica marcada em
///   EstoqueProducao.quantidadePendente até ser confirmada ou recusada.
model EntradaPendente {
  id                 Int       @id @default(autoincrement())
  tipo               String    // 'RETALHO' | 'DEVOLUCAO'
  status             String    @default("PENDENTE") // 'PENDENTE' | 'CONFIRMADA' | 'RECUSADA'
  materialId         Int
  quantidade         Decimal   @db.Decimal(15, 6)
  /// Linha de produção de origem ('1' ou '2').
  producao           String
  numeroOS           String?
  relacaoOSId        Int?
  /// Dados extras necessários para recriar/incrementar o retalho ao
  /// confirmar (RETALHO): dimensões usadas na baixa e preços apurados no
  /// momento em que a pendência foi criada.
  larguraUsada       Decimal?  @db.Decimal(15, 6)
  comprimentoUsado   Decimal?  @db.Decimal(15, 6)
  precoM2Final       Decimal?  @db.Decimal(15, 6)
  precoUnitarioFinal Decimal?  @db.Decimal(15, 6)
  observacao         String?
  usuarioNome        String?
  criadoEm           DateTime  @default(now())
  resolvidoEm        DateTime?
  material           Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([tipo])
  @@index([materialId])
  @@map("entradas_pendentes")
}

/// Histórico de movimentações do estoque de produção:
/// - TRANSFERENCIA: entrada vinda do estoque normal (Controle de Estoque).
/// - BAIXA: saída para uma OS específica (registrada pela página de Produção).
/// Histórico compartilhado entre as duas linhas de produção — o campo
/// [producao] indica de qual linha ('1' ou '2') veio cada movimentação.
model MovimentacaoProducao {
  id          Int      @id @default(autoincrement())
  materialId  Int
  tipo        String   // 'TRANSFERENCIA' | 'BAIXA'
  quantidade  Decimal  @db.Decimal(15, 6)
  numeroOS    String?  // preenchido apenas em BAIXA
  observacao  String?
  usuarioNome String?
  /// '1' ou '2' — linha de produção de origem/destino desta movimentação.
  producao    String
  criadoEm    DateTime @default(now())
  material    Material @relation(fields: [materialId], references: [id])

  @@index([materialId])
  @@index([numeroOS])
  @@index([producao])
  @@map("movimentacoes_producao")
}

model SolicitacaoProducao {
  id                  Int                       @id @default(autoincrement())
  numeroOS            String
  materialId          Int
  descricaoItem       String?
  observacao          String?
  quantidadeReservada Decimal                   @db.Decimal(15, 6)
  quantidadeUsada     Decimal                   @default(0) @db.Decimal(15, 6)
  status              StatusSolicitacaoProducao @default(FINALIZADA)
  usuarioId           Int
  usuarioNome         String
  criadoEm            DateTime                  @default(now())
  atualizadoEm        DateTime                  @updatedAt
  finalizadoEm        DateTime?
  baixas              BaixaProducao[]
  material            Material                  @relation(fields: [materialId], references: [id])
  usuario             Usuario                   @relation(fields: [usuarioId], references: [id])

  @@map("solicitacoes_producao")
}

model BaixaProducao {
  id            Int                 @id @default(autoincrement())
  solicitacaoId Int
  quantidade    Decimal             @db.Decimal(15, 6)
  observacao    String?
  criadoEm      DateTime            @default(now())
  solicitacao   SolicitacaoProducao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)

  @@map("baixas_producao")
}

model AuditLogMaterial {
  id          Int       @id @default(autoincrement())
  materialId  Int?
  acao        String
  campo       String?
  valorAntes  String?
  valorDepois String?
  usuarioId   Int?
  usuarioNome String?
  criadoEm    DateTime  @default(now())
  material    Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  materialNomeSnap          String?
  materialCategoriaSnap     String?
  materialUnidadeSnap       String?
  materialMedidaSnap        String?
  materialEspessuraSnap     String?
  materialIdentificadorSnap String?
  materialLarguraSnap       String?
  materialComprimentoSnap   String?

  @@index([materialId])
  @@index([criadoEm])
  @@map("audit_log_materiais")
}

model Veiculo {
  id           Int               @id @default(autoincrement())
  nome         String
  placa        String            @unique
  ativo        Boolean           @default(true)
  criadoEm     DateTime          @default(now())
  atualizadoEm DateTime          @updatedAt
  manutencoes  ManutencaoVeiculo[]

  @@map("veiculos")
}

model ManutencaoVeiculo {
  id           Int       @id @default(autoincrement())
  veiculoId    Int
  tipo         String
  descricao    String?
  valor        Decimal   @db.Decimal(10, 2)
  dataEnvio    DateTime
  dataRetirada DateTime?
  finalizada   Boolean   @default(false)
  finalizadaEm DateTime?
  criadoEm     DateTime  @default(now())
  veiculo      Veiculo   @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  @@map("manutencoes_veiculo")
}

model Cliente {
  id              Int              @id @default(autoincrement())
  nome            String
  telefone        String?
  email           String?
  documento       String?
  observacao      String?
  ativo           Boolean          @default(true)
  criadoEm        DateTime         @default(now())
  atualizadoEm    DateTime         @updatedAt
  orcamentosVenda OrcamentoVenda[]

  @@map("clientes")
}

model SolicitacaoMaterial {
  id               Int                          @id @default(autoincrement())
  numeroOS         String                       @unique
  nomeCliente      String
  dataNecessidade  DateTime
  andamento        String                       @default("EM_ANDAMENTO")
  observacao       String?
  usuarioId        Int
  usuarioNome      String
  criadoEm         DateTime                     @default(now())
  atualizadoEm     DateTime                     @updatedAt
 
  usuario          Usuario                      @relation("SolicitacoesMaterial", fields: [usuarioId], references: [id])
  itens            ItemSolicitacaoMaterial[]
  adicionais       AdicionalSolicitacaoMaterial[]
  logs             LogEdicaoSolicitacao[]
  visualizacoes    VisualizacaoSolicitacao[]
 
  @@index([andamento])
  @@index([dataNecessidade])
  @@map("solicitacoes_material")
}
 
model ItemSolicitacaoMaterial {
  id              Int                  @id @default(autoincrement())
  solicitacaoId   Int
  materialId      Int
  quantidade      Decimal              @db.Decimal(15, 6)
  observacao      String?
  imagemUrl       String?
 
  comprado        Boolean              @default(false)
  compradoEm      DateTime?
  compradoPorId   Int?
  compradoPorNome String?

  // Retirado do estoque em vez de comprado — mutuamente exclusivo com `comprado`.
  estoque         Boolean              @default(false)
  estoqueEm       DateTime?
  estoquePorId    Int?
  estoquePorNome  String?
 
  criadoEm        DateTime             @default(now())

  editadoEm       DateTime?
  editadoPorNome  String?
 
  solicitacao     SolicitacaoMaterial  @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  material        Material             @relation(fields: [materialId], references: [id])
 
  @@index([solicitacaoId])
  @@map("itens_solicitacao_material")
}
 
model AdicionalSolicitacaoMaterial {
  id              Int                  @id @default(autoincrement())
  solicitacaoId   Int
  materialId      Int
  quantidade      Decimal              @db.Decimal(15, 6)
  observacao      String?
  imagemUrl       String?
 
  adicionadoPorId   Int
  adicionadoPorNome String
  adicionadoEm      DateTime           @default(now())
 
  comprado        Boolean              @default(false)
  compradoEm      DateTime?
  compradoPorId   Int?
  compradoPorNome String?

  // Retirado do estoque em vez de comprado — mutuamente exclusivo com `comprado`.
  estoque         Boolean              @default(false)
  estoqueEm       DateTime?
  estoquePorId    Int?
  estoquePorNome  String?

  editadoEm       DateTime?
  editadoPorNome  String?
 
  solicitacao     SolicitacaoMaterial  @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  material        Material             @relation(fields: [materialId], references: [id])
 
  @@index([solicitacaoId])
  @@map("adicionais_solicitacao_material")
}

model VisualizacaoSolicitacao {
  id             Int                 @id @default(autoincrement())
  usuarioId      Int
  solicitacaoId  Int
  visualizadoEm  DateTime            @default(now())
  usuario        Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  solicitacao    SolicitacaoMaterial @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, solicitacaoId])
  @@index([usuarioId])
  @@index([solicitacaoId])
  @@map("visualizacoes_solicitacao")
}

model LogEdicaoSolicitacao {
  id              Int                 @id @default(autoincrement())
  solicitacaoId   Int
  editorId        Int
  editorNome      String
  antes           Json
  depois          Json
  editadoEm       DateTime            @default(now())
  item            String?
  solicitacao     SolicitacaoMaterial @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  editor          Usuario             @relation("LogEdicaoEditor", fields: [editorId], references: [id])

  @@index([solicitacaoId])
  @@map("logs_edicao_solicitacao")
}

model Produto {
  id             Int                  @id @default(autoincrement())
  nome           String
  descricao      String?
  categoria      String?
  ativo          Boolean              @default(true)
  criadoEm       DateTime             @default(now())
  atualizadoEm   DateTime             @updatedAt
  materiais      ProdutoMaterial[]
  orcamentoItens OrcamentoVendaItem[]

  @@map("produtos")
}

model ProdutoMaterial {
  id         Int      @id @default(autoincrement())
  produtoId  Int
  materialId Int
  quantidade Decimal  @default(1) @db.Decimal(10, 4)
  observacao String?
  criadoEm   DateTime @default(now())
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id])

  @@unique([produtoId, materialId])
  @@map("produto_materiais")
}

model OrcamentoVenda {
  id           Int                  @id @default(autoincrement())
  numero       String               @unique
  clienteId    Int?
  clienteNome  String?
  criadorId    Int?
  status       StatusOrcamentoVenda @default(EM_ANDAMENTO)
  observacao   String?
  valorTotal   Decimal              @default(0) @db.Decimal(15, 2)
  margemLucro  Decimal?             @db.Decimal(5, 2)
  criadoEm     DateTime             @default(now())
  atualizadoEm DateTime             @updatedAt
  cliente      Cliente?             @relation(fields: [clienteId], references: [id])
  criador      Usuario?             @relation("OrcamentoVendaCriador", fields: [criadorId], references: [id])
  itens        OrcamentoVendaItem[]

  @@map("orcamentos_venda")
}

model OrcamentoVendaItem {
  id               Int                        @id @default(autoincrement())
  orcamentoVendaId Int
  produtoId        Int
  quantidade       Decimal                    @default(1) @db.Decimal(15, 6)
  observacao       String?
  criadoEm         DateTime                   @default(now())
  orcamentoVenda   OrcamentoVenda             @relation(fields: [orcamentoVendaId], references: [id], onDelete: Cascade)
  produto          Produto                    @relation(fields: [produtoId], references: [id])
  materiais        OrcamentoVendaItemMaterial[]

  @@map("orcamento_venda_itens")
}

model OrcamentoVendaItemMaterial {
  id                   Int                @id @default(autoincrement())
  orcamentoVendaItemId Int
  materialId           Int
  quantidade           Decimal            @db.Decimal(10, 4)
  precoMedio           Decimal?           @db.Decimal(15, 6)
  precoMedioM2         Decimal?           @db.Decimal(15, 6)
  precoUnitario        Decimal?           @db.Decimal(15, 6)
  largura              Decimal?           @db.Decimal(10, 4)
  comprimento          Decimal?           @db.Decimal(10, 4)
  usarM2               Boolean            @default(false)
  criadoEm             DateTime           @default(now())
  orcamentoVendaItem   OrcamentoVendaItem @relation(fields: [orcamentoVendaItemId], references: [id], onDelete: Cascade)
  material             Material           @relation(fields: [materialId], references: [id])

  @@unique([orcamentoVendaItemId, materialId])
  @@map("orcamento_venda_item_materiais")
}

model MarkupFaixa {
  id           Int      @id @default(autoincrement())
  ordem        Int
  valorMin     Decimal  @db.Decimal(15, 2)
  valorMax     Decimal? @db.Decimal(15, 2)
  percentual   Decimal  @db.Decimal(7, 2)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("markup_faixas")
}

model ConfiguracaoSistema {
  chave        String   @id
  valor        String
  atualizadoEm DateTime @updatedAt

  @@map("configuracoes_sistema")
}

enum Role {
  ADMIN
  GERENTE
  COMPRAS
  PRODUCAO1
  PRODUCAO2
  ORCAMENTISTA
}

enum StatusEstoque {
  OK
  LIMITE
  CRITICO
  INATIVO
}

enum StatusOrcamento {
  ABERTO
  AGUARDANDO_APROVACAO
  APROVADO
  NAO_APROVADO
  CONVERTIDO
  CANCELADO
}

enum StatusOrdemCompra {
  EM_ANDAMENTO
  FINALIZADO
  CANCELADO
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

enum StatusSolicitacaoProducao {
  ABERTA
  EM_USO
  FINALIZADA
}

enum StatusOrcamentoVenda {
  EM_ANDAMENTO
  APROVADO
  NAO_APROVADO
}
