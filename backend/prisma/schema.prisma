generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                   Int                   @id @default(autoincrement())
  nome                 String
  username             String                @unique
  senha                String
  role                 Role                  @default(COMPRAS)
  ativo                Boolean               @default(true)
  criadoEm             DateTime              @default(now())
  atualizadoEm         DateTime              @updatedAt
  orcamentosAprovados  Orcamento[]           @relation("AprovadorOrcamento")
  orcamentosCriados    Orcamento[]           @relation("OrcamentoCriador")
  ordens_compra        OrdemCompra[]
  solicitacoesProducao SolicitacaoProducao[]

  @@map("usuarios")
}

model Material {
  id                   Int                      @id @default(autoincrement())
  nome                 String
  unidade              String?
  categoria            String?
  medida               String?
  espessura            String?
  largura              Decimal?                 @db.Decimal(10, 4)
  comprimento          Decimal?                 @db.Decimal(10, 4)
  identificador        String?
  valor                Decimal?                 @db.Decimal(15, 5)
  valorMetroQuadrado   Decimal?                 @db.Decimal(15, 5)
  quantidade           Decimal                  @default(0) @db.Decimal(10, 3)
  estoqueMinimo        Decimal                  @default(0) @db.Decimal(10, 3)
  status               StatusEstoque            @default(OK)
  estoqueConfirmado    Boolean                  @default(false)
  ativo                Boolean                  @default(true)
  especifico           Boolean                  @default(false)
  ultimoValorPago      Decimal?                 @db.Decimal(15, 5)
  ultimoValorPagoM2    Decimal?                 @db.Decimal(15, 5)
  criadoEm             DateTime                 @default(now())
  atualizadoEm         DateTime                 @updatedAt
  estoquesEspecificos  EstoqueEspecifico[]
  fornecedorMateriais  FornecedorMaterial[]
  historicoPrecos      HistoricoPrecoMaterial[]
  movimentacoes        MovimentacaoEstoque[]
  orcamentoItens       OrcamentoItem[]
  ordemItens           OrdemCompraItem[]
  SolicitacoesProducao SolicitacaoProducao[]
  auditLogs  AuditLogMaterial[]

  @@unique([nome, medida, espessura])
  @@map("materiais")
}

model EstoqueEspecifico {
  id                Int      @id @default(autoincrement())
  materialId        Int
  descricao         String
  quantidade        Decimal  @default(0) @db.Decimal(10, 3)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt
  ultimoValorPago   Decimal? @db.Decimal(15, 5)
  ultimoValorPagoM2 Decimal? @db.Decimal(15, 5)
  material          Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, descricao])
  @@map("estoque_especificos")
}

model HistoricoPrecoMaterial {
  id            Int         @id @default(autoincrement())
  materialId    Int
  ordemCompraId Int
  fornecedorId  Int
  precoUnitario Decimal?    @db.Decimal(15, 5)
  precoM2       Decimal?    @db.Decimal(15, 5)
  quantidade    Decimal     @db.Decimal(10, 3)
  usarM2        Boolean     @default(false)
  criadoEm      DateTime    @default(now())
  fornecedor    Fornecedor  @relation(fields: [fornecedorId], references: [id])
  material      Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  ordemCompra   OrdemCompra @relation(fields: [ordemCompraId], references: [id], onDelete: Cascade)

  @@map("historico_precos_material")
}

model Fornecedor {
  id              Int                      @id @default(autoincrement())
  nomeFantasia    String
  tipoFornecedor  String?
  telefone        String?
  cnpj            String?                  @unique
  razaoSocial     String?
  nomeVendedor    String?
  ativo           Boolean                  @default(true)
  criadoEm        DateTime                 @default(now())
  atualizadoEm    DateTime                 @updatedAt
  materiais       FornecedorMaterial[]
  historicoPrecos HistoricoPrecoMaterial[]
  orcamentoItens  OrcamentoItem[]
  ordens_compra   OrdemCompra[]

  @@map("fornecedores")
}

model FornecedorMaterial {
  id                 Int        @id @default(autoincrement())
  fornecedorId       Int
  materialId         Int
  preco              Decimal?   @db.Decimal(15, 5)
  precoMetroQuadrado Decimal?   @db.Decimal(15, 5)
  ativo              Boolean    @default(true)
  criadoEm           DateTime   @default(now())
  atualizadoEm       DateTime   @updatedAt
  fornecedor         Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  material           Material   @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([fornecedorId, materialId])
  @@map("fornecedor_materiais")
}

model Orcamento {
  id             Int             @id @default(autoincrement())
  titulo         String          @default("Orçamento")
  status         StatusOrcamento @default(ABERTO)
  criadorId      Int?
  aprovadorId    Int?
  aprovadoEm     DateTime?
  motivoRejeicao String?
  criadoEm       DateTime        @default(now())
  atualizadoEm   DateTime        @updatedAt
  itens          OrcamentoItem[]
  aprovador      Usuario?        @relation("AprovadorOrcamento", fields: [aprovadorId], references: [id])
  criador        Usuario?        @relation("OrcamentoCriador", fields: [criadorId], references: [id])
  ordens         OrdemCompra[]

  @@map("orcamentos")
}

model OrcamentoItem {
  id            Int         @id @default(autoincrement())
  orcamentoId   Int
  materialId    Int
  fornecedorId  Int?
  quantidade    Decimal     @default(1) @db.Decimal(10, 3)
  precoUnitario Decimal?    @db.Decimal(15, 5)
  precoM2       Decimal?    @db.Decimal(15, 5)
  usarM2        Boolean     @default(false)
  selecionado   Boolean     @default(false)
  descricaoItem String?
  criadoEm      DateTime    @default(now())
  fornecedor    Fornecedor? @relation(fields: [fornecedorId], references: [id])
  material      Material    @relation(fields: [materialId], references: [id])
  orcamento     Orcamento   @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@unique([orcamentoId, materialId, fornecedorId])
  @@map("orcamento_itens")
}

model OrdemCompra {
  id              Int                      @id @default(autoincrement())
  data            DateTime                 @default(now())
  fornecedorId    Int
  requisitante    String
  formaPagamento  String?
  prazoPagamento  String?
  observacoes     String?
  empresa         String?
  status          StatusOrdemCompra        @default(EM_ANDAMENTO)
  usuarioId       Int?
  orcamentoId     Int?
  valorTotal      Decimal                  @default(0) @db.Decimal(15, 5)
  criadoEm        DateTime                 @default(now())
  atualizadoEm    DateTime                 @updatedAt
  historicoPrecos HistoricoPrecoMaterial[]
  movimentacoes   MovimentacaoEstoque[]
  itens           OrdemCompraItem[]
  numerosOS       OrdemCompraOS[]
  fornecedor      Fornecedor               @relation(fields: [fornecedorId], references: [id])
  orcamento       Orcamento?               @relation(fields: [orcamentoId], references: [id])
  usuario         Usuario?                 @relation(fields: [usuarioId], references: [id])

  @@map("ordens_compra")
}

model OrdemCompraOS {
  id            Int         @id @default(autoincrement())
  ordemCompraId Int
  numeroOS      String
  ordemCompra   OrdemCompra @relation(fields: [ordemCompraId], references: [id], onDelete: Cascade)

  @@map("ordem_compra_os")
}

model OrdemCompraItem {
  id                 Int         @id @default(autoincrement())
  ordemCompraId      Int
  materialId         Int
  descricaoItem      String?
  numeroOS           String
  quantidade         Decimal     @db.Decimal(10, 3)
  precoUnitario      Decimal     @db.Decimal(15, 5)
  precoMetroQuadrado Decimal?    @db.Decimal(15, 5)
  usarM2             Boolean     @default(false)
  precoTotal         Decimal     @db.Decimal(15, 5)
  criadoEm           DateTime    @default(now())
  material           Material    @relation(fields: [materialId], references: [id])
  ordemCompra        OrdemCompra @relation(fields: [ordemCompraId], references: [id], onDelete: Cascade)

  @@map("ordem_compra_itens")
}

model RelacaoOS {
  id            Int                   @id @default(autoincrement())
  numeroOS      String                @unique
  descricao     String?
  status        String                @default("EM_ANDAMENTO")
  criadoEm      DateTime              @default(now())
  atualizadoEm  DateTime              @updatedAt
  movimentacoes MovimentacaoEstoque[]

  @@map("relacoes_os")
}

model MovimentacaoEstoque {
  id            Int          @id @default(autoincrement())
  materialId    Int
  tipo          String
  quantidade    Decimal      @db.Decimal(10, 3)
  numeroOS      String
  relacaoOSId   Int
  ordemCompraId Int?
  precoUnitario Decimal?     @db.Decimal(15, 5)
  precoM2       Decimal?     @db.Decimal(15, 5)
  observacao    String?
  descricaoItem String?
  criadoEm      DateTime     @default(now())
  material      Material     @relation(fields: [materialId], references: [id])
  ordemCompra   OrdemCompra? @relation(fields: [ordemCompraId], references: [id])
  relacaoOS     RelacaoOS    @relation(fields: [relacaoOSId], references: [id])

  @@map("movimentacoes_estoque")
}

// Campo `observacao` adicionado para registrar a observação da solicitação.
// Status simplificado: apenas FINALIZADA é usado daqui em diante.
// Os valores ABERTA e EM_USO permanecem no enum para compatibilidade com
// registros históricos já existentes no banco.
model SolicitacaoProducao {
  id                  Int                       @id @default(autoincrement())
  numeroOS            String
  materialId          Int
  descricaoItem       String?
  observacao          String?                   // observação opcional da saída
  quantidadeReservada Decimal                   @db.Decimal(10, 3)
  quantidadeUsada     Decimal                   @default(0) @db.Decimal(10, 3)
  status              StatusSolicitacaoProducao @default(FINALIZADA)
  usuarioId           Int
  usuarioNome         String
  criadoEm            DateTime                  @default(now())
  atualizadoEm        DateTime                  @updatedAt
  finalizadoEm        DateTime?
  baixas              BaixaProducao[]
  material            Material                  @relation(fields: [materialId], references: [id])
  usuario             Usuario                   @relation(fields: [usuarioId], references: [id])

  @@map("solicitacoes_producao")
}

model BaixaProducao {
  id            Int                 @id @default(autoincrement())
  solicitacaoId Int
  quantidade    Decimal             @db.Decimal(10, 3)
  observacao    String?
  criadoEm      DateTime            @default(now())
  solicitacao   SolicitacaoProducao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)

  @@map("baixas_producao")
}

enum Role {
  ADMIN
  GERENTE
  COMPRAS
  PRODUCAO
}

enum StatusEstoque {
  OK
  LIMITE
  CRITICO
  INATIVO
}

enum StatusOrcamento {
  ABERTO
  AGUARDANDO_APROVACAO
  APROVADO
  NAO_APROVADO
  CONVERTIDO
  CANCELADO
}

enum StatusOrdemCompra {
  EM_ANDAMENTO
  FINALIZADO
  CANCELADO
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

// ABERTA e EM_USO mantidos apenas para compatibilidade com dados históricos.
// Novas solicitações são criadas diretamente como FINALIZADA.
enum StatusSolicitacaoProducao {
  ABERTA
  EM_USO
  FINALIZADA
}

model AuditLogMaterial {
  id           Int      @id @default(autoincrement())
  materialId   Int
  acao         String   // 'CADASTRO' | 'EDICAO' | 'DESATIVACAO' | 'REATIVACAO' | 'EXCLUSAO' | 'ESTOQUE_CONFIRMADO' | 'FILHO_EDITADO' | 'FILHO_EXCLUIDO'
  campo        String?  // campo alterado (só em EDICAO / FILHO_EDITADO)
  valorAntes   String?  // valor anterior (serializado como string/JSON)
  valorDepois  String?  // novo valor
  usuarioId    Int?
  usuarioNome  String?
  criadoEm     DateTime @default(now())
  material     Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([criadoEm])
  @@map("audit_log_materiais")
}

model Veiculo {
  id           Int                  @id @default(autoincrement())
  nome         String
  placa        String               @unique
  ativo        Boolean              @default(true)
  criadoEm     DateTime             @default(now())
  atualizadoEm DateTime             @updatedAt
  manutencoes  ManutencaoVeiculo[]

  @@map("veiculos")
}

model ManutencaoVeiculo {
  id          Int       @id @default(autoincrement())
  veiculoId   Int
  tipo        String    // "MANUTENCAO" | "LIMPEZA" | "REVISAO" | "PNEU" | "OUTRO"
  descricao   String?
  valor       Decimal   @db.Decimal(10, 2)
  dataEnvio   DateTime
  dataRetirada DateTime?
  criadoEm   DateTime  @default(now())

  veiculo     Veiculo   @relation(fields: [veiculoId], references: [id])

  @@map("manutencoes_veiculo")
}