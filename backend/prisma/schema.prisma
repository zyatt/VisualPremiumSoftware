generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                   Int                   @id @default(autoincrement())
  nome                 String
  username             String                @unique
  senha                String
  role                 Role                  @default(COMPRAS)
  ativo                Boolean               @default(true)
  criadoEm             DateTime              @default(now())
  atualizadoEm         DateTime              @updatedAt
  orcamentosAprovados  Orcamento[]           @relation("AprovadorOrcamento")
  orcamentosCriados    Orcamento[]           @relation("OrcamentoCriador")
  ordens_compra        OrdemCompra[]
  solicitacoesProducao SolicitacaoProducao[]
  orcamentosVendaCriados OrcamentoVenda[]    @relation("OrcamentoVendaCriador")

  @@map("usuarios")
}

model Material {
  id                   Int                      @id @default(autoincrement())
  nome                 String
  unidade              String?
  categoria            String?
  medida               String?
  espessura            String?
  largura              Decimal?                 @db.Decimal(10, 4)
  comprimento          Decimal?                 @db.Decimal(10, 4)
  identificador        String?
  valor                Decimal?                 @db.Decimal(15, 6)
  valorMetroQuadrado   Decimal?                 @db.Decimal(15, 6)
  quantidade           Decimal                  @default(0) @db.Decimal(10, 3)
  estoqueMinimo        Decimal                  @default(0) @db.Decimal(10, 3)
  qtdPadrao            Decimal?                 @db.Decimal(15, 6)
  unidPadrao           String?
  status               StatusEstoque            @default(OK)
  estoqueConfirmado    Boolean                  @default(false)
  ativo                Boolean                  @default(true)
  especifico           Boolean                  @default(false)
  ultimoValorPago      Decimal?                 @db.Decimal(15, 6)
  ultimoValorPagoM2    Decimal?                 @db.Decimal(15, 6)
  criadoEm             DateTime                 @default(now())
  atualizadoEm         DateTime                 @updatedAt
  estoquesEspecificos  EstoqueEspecifico[]
  fornecedorMateriais  FornecedorMaterial[]
  historicoPrecos      HistoricoPrecoMaterial[]
  movimentacoes        MovimentacaoEstoque[]
  orcamentoItens       OrcamentoItem[]
  ordemItens           OrdemCompraItem[]
  SolicitacoesProducao SolicitacaoProducao[]
  auditLogs            AuditLogMaterial[]
  produtoMateriais     ProdutoMaterial[]
  orcamentoVendaItemMateriais OrcamentoVendaItemMaterial[]

  @@unique([nome, identificador, medida, espessura])

  @@map("materiais")
}

model EstoqueEspecifico {
  id                Int      @id @default(autoincrement())
  materialId        Int
  descricao         String
  quantidade        Decimal  @default(0) @db.Decimal(10, 3)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt
  ultimoValorPago   Decimal? @db.Decimal(15, 6)
  ultimoValorPagoM2 Decimal? @db.Decimal(15, 6)
  material          Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, descricao])
  @@map("estoque_especificos")
}

model HistoricoPrecoMaterial {
  id            Int         @id @default(autoincrement())
  materialId    Int
  ordemCompraId Int
  fornecedorId  Int
  precoUnitario Decimal?    @db.Decimal(15, 6)
  precoM2       Decimal?    @db.Decimal(15, 6)
  quantidade    Decimal     @db.Decimal(10, 3)
  usarM2        Boolean     @default(false)
  criadoEm      DateTime    @default(now())
  fornecedor    Fornecedor  @relation(fields: [fornecedorId], references: [id])
  material      Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  ordemCompra   OrdemCompra @relation(fields: [ordemCompraId], references: [id], onDelete: Cascade)

  @@map("historico_precos_material")
}

model Fornecedor {
  id              Int                      @id @default(autoincrement())
  nomeFantasia    String
  tipoFornecedor  String?
  telefone        String?
  cnpj            String?                  @unique
  razaoSocial     String?
  nomeVendedor    String?
  ativo           Boolean                  @default(true)
  criadoEm        DateTime                 @default(now())
  atualizadoEm    DateTime                 @updatedAt
  materiais       FornecedorMaterial[]
  historicoPrecos HistoricoPrecoMaterial[]
  orcamentoItens  OrcamentoItem[]
  ordens_compra   OrdemCompra[]

  @@map("fornecedores")
}

model FornecedorMaterial {
  id                 Int        @id @default(autoincrement())
  fornecedorId       Int
  materialId         Int
  preco              Decimal?   @db.Decimal(15, 6)
  precoMetroQuadrado Decimal?   @db.Decimal(15, 6)
  ativo              Boolean    @default(true)
  criadoEm           DateTime   @default(now())
  atualizadoEm       DateTime   @updatedAt
  fornecedor         Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  material           Material   @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([fornecedorId, materialId])
  @@map("fornecedor_materiais")
}

model Orcamento {
  id             Int             @id @default(autoincrement())
  titulo         String          @default("Orçamento")
  status         StatusOrcamento @default(ABERTO)
  criadorId      Int?
  aprovadorId    Int?
  aprovadoEm     DateTime?
  motivoRejeicao String?
  criadoEm       DateTime        @default(now())
  atualizadoEm   DateTime        @updatedAt
  // IDs de fornecedores ocultados da visualização deste orçamento (matriz, totais,
  // melhor preço e PDF). Apenas oculta — o fornecedor e os itens/preços permanecem
  // intactos no banco; ocultar/reexibir é reversível e visível para qualquer usuário
  // que abrir o orçamento.
  fornecedoresOcultos Int[]      @default([])
  itens          OrcamentoItem[]
  aprovador      Usuario?        @relation("AprovadorOrcamento", fields: [aprovadorId], references: [id])
  criador        Usuario?        @relation("OrcamentoCriador", fields: [criadorId], references: [id])
  ordens         OrdemCompra[]

  @@map("orcamentos")
}

model OrcamentoItem {
  id            Int         @id @default(autoincrement())
  orcamentoId   Int
  materialId    Int
  fornecedorId  Int?
  quantidade    Decimal     @default(1) @db.Decimal(10, 3)
  precoUnitario Decimal?    @db.Decimal(15, 6)
  precoM2       Decimal?    @db.Decimal(15, 6)
  usarM2        Boolean     @default(false)
  selecionado   Boolean     @default(false)
  descricaoItem String?
  criadoEm      DateTime    @default(now())
  fornecedor    Fornecedor? @relation(fields: [fornecedorId], references: [id])
  material      Material    @relation(fields: [materialId], references: [id])
  orcamento     Orcamento   @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@unique([orcamentoId, materialId, fornecedorId])
  @@map("orcamento_itens")
}

model OrdemCompra {
  id              Int                      @id @default(autoincrement())
  data            DateTime                 @default(now())
  fornecedorId    Int
  requisitante    String
  formaPagamento  String?
  prazoPagamento  String?
  observacoes     String?
  empresa         String?
  status          StatusOrdemCompra        @default(EM_ANDAMENTO)
  usuarioId       Int?
  orcamentoId     Int?
  valorTotal      Decimal                  @default(0) @db.Decimal(15, 6)
  criadoEm        DateTime                 @default(now())
  atualizadoEm    DateTime                 @updatedAt
  historicoPrecos HistoricoPrecoMaterial[]
  movimentacoes   MovimentacaoEstoque[]
  itens           OrdemCompraItem[]
  numerosOS       OrdemCompraOS[]
  fornecedor      Fornecedor               @relation(fields: [fornecedorId], references: [id])
  orcamento       Orcamento?               @relation(fields: [orcamentoId], references: [id])
  usuario         Usuario?                 @relation(fields: [usuarioId], references: [id])

  @@map("ordens_compra")
}

model OrdemCompraOS {
  id            Int         @id @default(autoincrement())
  ordemCompraId Int
  numeroOS      String
  ordemCompra   OrdemCompra @relation(fields: [ordemCompraId], references: [id], onDelete: Cascade)

  @@map("ordem_compra_os")
}

model OrdemCompraItem {
  id                 Int         @id @default(autoincrement())
  ordemCompraId      Int
  materialId         Int
  descricaoItem      String?
  numeroOS           String
  quantidade         Decimal     @db.Decimal(10, 3)
  qtdUnidade         Decimal?    @db.Decimal(15, 6)
  precoUnitario      Decimal     @db.Decimal(15, 6)
  precoMetroQuadrado Decimal?    @db.Decimal(15, 6)
  usarM2             Boolean     @default(false)
  precoTotal         Decimal     @db.Decimal(15, 6)
  criadoEm           DateTime    @default(now())
  material           Material    @relation(fields: [materialId], references: [id])
  ordemCompra        OrdemCompra @relation(fields: [ordemCompraId], references: [id], onDelete: Cascade)

  @@map("ordem_compra_itens")
}

model RelacaoOS {
  id            Int                   @id @default(autoincrement())
  numeroOS      String                @unique
  descricao     String?
  status        String                @default("EM_ANDAMENTO")
  criadoEm      DateTime              @default(now())
  atualizadoEm  DateTime              @updatedAt
  movimentacoes MovimentacaoEstoque[]

  @@map("relacoes_os")
}

model MovimentacaoEstoque {
  id                Int          @id @default(autoincrement())
  materialId        Int
  tipo              String
  quantidade        Decimal      @db.Decimal(10, 3)
  numeroOS          String
  relacaoOSId       Int
  ordemCompraId     Int?
  precoUnitario     Decimal?     @db.Decimal(15, 6)
  precoM2           Decimal?     @db.Decimal(15, 6)
  observacao        String?
  descricaoItem     String?
  larguraUsada      Decimal?     @db.Decimal(15, 6)
  comprimentoUsado  Decimal?     @db.Decimal(15, 6)
  criadoEm          DateTime     @default(now())
  material          Material     @relation(fields: [materialId], references: [id])
  ordemCompra       OrdemCompra? @relation(fields: [ordemCompraId], references: [id])
  relacaoOS         RelacaoOS    @relation(fields: [relacaoOSId], references: [id])

  @@map("movimentacoes_estoque")
}

model SolicitacaoProducao {
  id                  Int                       @id @default(autoincrement())
  numeroOS            String
  materialId          Int
  descricaoItem       String?
  observacao          String?
  quantidadeReservada Decimal                   @db.Decimal(10, 3)
  quantidadeUsada     Decimal                   @default(0) @db.Decimal(10, 3)
  status              StatusSolicitacaoProducao @default(FINALIZADA)
  usuarioId           Int
  usuarioNome         String
  criadoEm            DateTime                  @default(now())
  atualizadoEm        DateTime                  @updatedAt
  finalizadoEm        DateTime?
  baixas              BaixaProducao[]
  material            Material                  @relation(fields: [materialId], references: [id])
  usuario             Usuario                   @relation(fields: [usuarioId], references: [id])

  @@map("solicitacoes_producao")
}

model BaixaProducao {
  id            Int                 @id @default(autoincrement())
  solicitacaoId Int
  quantidade    Decimal             @db.Decimal(10, 3)
  observacao    String?
  criadoEm      DateTime            @default(now())
  solicitacao   SolicitacaoProducao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)

  @@map("baixas_producao")
}

model AuditLogMaterial {
  id           Int      @id @default(autoincrement())
  materialId   Int
  acao         String
  campo        String?
  valorAntes   String?
  valorDepois  String?
  usuarioId    Int?
  usuarioNome  String?
  criadoEm     DateTime @default(now())
  material     Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([criadoEm])
  @@map("audit_log_materiais")
}

model Veiculo {
  id           Int                  @id @default(autoincrement())
  nome         String
  placa        String               @unique
  ativo        Boolean              @default(true)
  criadoEm     DateTime             @default(now())
  atualizadoEm DateTime             @updatedAt
  manutencoes  ManutencaoVeiculo[]

  @@map("veiculos")
}

model ManutencaoVeiculo {
  id           Int       @id @default(autoincrement())
  veiculoId    Int
  tipo         String
  descricao    String?
  valor        Decimal   @db.Decimal(10, 2)
  dataEnvio    DateTime
  dataRetirada DateTime?
  criadoEm     DateTime  @default(now())
  veiculo      Veiculo   @relation(fields: [veiculoId], references: [id])

  @@map("manutencoes_veiculo")
}

// ─── NOVAS ENTIDADES ──────────────────────────────────────────────────────────

model Cliente {
  id              Int              @id @default(autoincrement())
  nome            String
  telefone        String?
  email           String?
  documento       String?
  observacao      String?
  ativo           Boolean          @default(true)
  criadoEm        DateTime         @default(now())
  atualizadoEm    DateTime         @updatedAt
  orcamentosVenda OrcamentoVenda[]

  @@map("clientes")
}

model Produto {
  id             Int                  @id @default(autoincrement())
  nome           String
  descricao      String?
  categoria      String?
  ativo          Boolean              @default(true)
  criadoEm       DateTime             @default(now())
  atualizadoEm   DateTime             @updatedAt
  materiais      ProdutoMaterial[]
  orcamentoItens OrcamentoVendaItem[]

  @@map("produtos")
}

/// Vincula um material a um produto com a quantidade padrão por unidade do produto.
model ProdutoMaterial {
  id         Int      @id @default(autoincrement())
  produtoId  Int
  materialId Int
  /// Quantidade do material necessária para 1 unidade do produto.
  quantidade Decimal  @default(1) @db.Decimal(10, 4)
  observacao String?
  criadoEm   DateTime @default(now())
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id])

  @@unique([produtoId, materialId])
  @@map("produto_materiais")
}

model OrcamentoVenda {
  id           Int                  @id @default(autoincrement())
  numero       String               @unique
  clienteId    Int?
  clienteNome  String?
  criadorId    Int?
  status       StatusOrcamentoVenda @default(EM_ANDAMENTO)
  observacao   String?
  valorTotal   Decimal              @default(0) @db.Decimal(15, 2)
  /// Percentual de margem global aplicado sobre o custo (opcional).
  margemLucro  Decimal?             @db.Decimal(5, 2)
  criadoEm     DateTime             @default(now())
  atualizadoEm DateTime             @updatedAt
  cliente      Cliente?             @relation(fields: [clienteId], references: [id])
  criador      Usuario?             @relation("OrcamentoVendaCriador", fields: [criadorId], references: [id])
  itens        OrcamentoVendaItem[]

  @@map("orcamentos_venda")
}

/// Produto selecionado dentro de um orçamento de venda.
model OrcamentoVendaItem {
  id               Int                         @id @default(autoincrement())
  orcamentoVendaId Int
  produtoId        Int
  quantidade       Decimal                     @default(1) @db.Decimal(10, 3)
  observacao       String?
  criadoEm         DateTime                    @default(now())
  orcamentoVenda   OrcamentoVenda              @relation(fields: [orcamentoVendaId], references: [id], onDelete: Cascade)
  produto          Produto                     @relation(fields: [produtoId], references: [id])
  materiais        OrcamentoVendaItemMaterial[]

  @@map("orcamento_venda_itens")
}

/// Detalhe de material dentro de um item do orçamento de venda.
/// Permite ajuste de quantidade e registra snapshot do preço médio.
model OrcamentoVendaItemMaterial {
  id                   Int                @id @default(autoincrement())
  orcamentoVendaItemId Int
  materialId           Int
  /// Quantidade ajustada pelo usuário.
  quantidade           Decimal            @db.Decimal(10, 4)
  /// Snapshot do preço médio dos fornecedores no momento do orçamento.
  precoMedio           Decimal?           @db.Decimal(15, 6)
  precoMedioM2         Decimal?           @db.Decimal(15, 6)
  /// Preço unitário final (pode ser editado manualmente).
  precoUnitario        Decimal?           @db.Decimal(15, 6)
  /// Dimensões informadas pelo usuário no orçamento (para cálculo de área).
  largura              Decimal?           @db.Decimal(10, 4)
  comprimento          Decimal?           @db.Decimal(10, 4)
  usarM2               Boolean            @default(false)
  criadoEm             DateTime           @default(now())
  orcamentoVendaItem   OrcamentoVendaItem @relation(fields: [orcamentoVendaItemId], references: [id], onDelete: Cascade)
  material             Material           @relation(fields: [materialId], references: [id])

  @@unique([orcamentoVendaItemId, materialId])
  @@map("orcamento_venda_item_materiais")
}

/// Faixas de markup: para valorTotal entre valorMin e valorMax aplica-se percentual.
/// valorMax null = faixa aberta (>= valorMin sem limite superior).
model MarkupFaixa {
  id           Int      @id @default(autoincrement())
  ordem        Int
  valorMin     Decimal  @db.Decimal(15, 2)
  valorMax     Decimal? @db.Decimal(15, 2)
  percentual   Decimal  @db.Decimal(7, 2)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("markup_faixas")
}

/// Configuracoes globais do sistema (chave/valor).
model ConfiguracaoSistema {
  chave        String   @id
  valor        String
  atualizadoEm DateTime @updatedAt

  @@map("configuracoes_sistema")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  GERENTE
  COMPRAS
  PRODUCAO
  ORCAMENTISTA
}

enum StatusEstoque {
  OK
  LIMITE
  CRITICO
  INATIVO
}

enum StatusOrcamento {
  ABERTO
  AGUARDANDO_APROVACAO
  APROVADO
  NAO_APROVADO
  CONVERTIDO
  CANCELADO
}

enum StatusOrdemCompra {
  EM_ANDAMENTO
  FINALIZADO
  CANCELADO
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

enum StatusSolicitacaoProducao {
  ABERTA
  EM_USO
  FINALIZADA
}

enum StatusOrcamentoVenda {
  EM_ANDAMENTO
  APROVADO
  NAO_APROVADO
}
